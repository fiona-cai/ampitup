# Copy to .env.local. Everything is optional; without these the app runs on the sample week.

# Claude sets budget amounts. Without a key, policy rates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google sign-in. From Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <current origin>/api/auth/google/callback. Must match a redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=

# Who counts as internal. Defaults to the signed-in user's email domain.
COMPANY_DOMAIN=
COMPANY_NAME=
# Days with every event in this city count as home days.
HOME_CITY=Waterloo

# Read-only Notion event context. Keep tokens on the server, never in NEXT_PUBLIC_*.
NOTION_TOKEN=
# Database ID/URL; the connector resolves its data source. Alternatively set NOTION_DATA_SOURCE_ID.
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=
# The supplied Notion fixture contains synthetic facts even when read through the real API.
NOTION_IS_SIMULATED=true
