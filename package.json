{
  "name": "allot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/*.test.ts",
    "harness": "uv run --project protocol python protocol/harness.py",
